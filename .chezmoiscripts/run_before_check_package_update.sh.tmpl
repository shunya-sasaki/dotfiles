{{- if (or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin")) -}}
{{- $profile := includeTemplate "profile" . | trim -}}

{{- $cachedClaudeVersion := index . "claudeVersion" | default "" -}}
{{- $cachedClaudeHash := index . "claudeHash" | default "" -}}

{{- $cachedCopilotVersion := index . "copilotVersion" | default "" -}}
{{- $cachedCopilotHash := index . "copilotHash" | default "" -}}

{{- $cachedCodexVersion := index . "codexVersion" | default "" -}}
{{- $cachedCodexHash := index . "codexHash" | default "" -}}

{{- $cachedZedVersion := index . "zedVersion" | default "" -}}
{{- $cachedZedHash := index . "zedHash" | default "" -}}

{{- $cachedMiseVersion := index . "miseVersion" | default "" -}}
{{- $cachedMiseHash := index . "miseHash" | default "" -}}

{{- $cachedAntigravityVersion := index . "antigravityVersion" | default "" -}}
{{- $cachedAntigravityHash := index . "antigravityHash" | default "" -}}

{{- $cachedOllamaVersion := index . "ollamaVersion" | default "" -}}
{{- $cachedOllamaHash := index . "ollamaHash" | default "" -}}

{{- $cachedObsidianVersion := index . "obsidianVersion" | default "" -}}
{{- $cachedObsidianHash := index . "obsidianHash" | default "" -}}

#!/bin/sh
claude_version="{{- includeTemplate "claude-version" . -}}"
if [ "$claude_version" = "{{- $cachedClaudeVersion -}}" ] \
    && [ -n "{{- $cachedClaudeHash -}}" ]; then
    echo "Claude Code: up to date ($claude_version), using cached hash."
    claude_hash="{{- $cachedClaudeHash -}}"
else
    echo "Claude Code: new version $claude_version, hash updated."
    claude_hash="{{- includeTemplate "claude-hash" . -}}"
fi

copilot_version="{{- includeTemplate "copilot-version" . -}}"
if [ "$copilot_version" = "{{- $cachedCopilotVersion -}}" ] \
    && [ -n "{{- $cachedCopilotHash -}}" ]; then
    echo "GitHub Copilot: up to date ($copilot_version), using cached hash."
    copilot_hash="{{- $cachedCopilotHash -}}"
else
    echo "GitHub Copilot: new version $copilot_version, hash updated."
    copilot_hash="{{- includeTemplate "copilot-hash" . -}}"
fi

codex_version="{{- includeTemplate "codex-version" . -}}"
if [ "$codex_version" = "{{- $cachedCodexVersion -}}" ] \
    && [ -n "{{- $cachedCodexHash -}}" ]; then
    echo "Codex: up to date ($codex_version), using cached hash."
    codex_hash="{{- $cachedCodexHash -}}"
else
    echo "Codex: new version $codex_version, hash updated."
    codex_hash="{{- includeTemplate "codex-hash" . -}}"
fi

zed_version="{{- includeTemplate "zed-version" . -}}"
if [ "$zed_version" = "{{- $cachedZedVersion -}}" ] \
    && [ -n "{{- $cachedZedHash -}}" ]; then
    echo "Zed: up to date ($zed_version), using cached hash."
    zed_hash="{{- $cachedZedHash -}}"
else
    echo "Zed: new version $zed_version, hash updated."
    zed_hash="{{- includeTemplate "zed-hash" . -}}"
fi

mise_version="{{- includeTemplate "mise-version" . -}}"
if [ "$mise_version" = "{{- $cachedMiseVersion -}}" ] \
    && [ -n "{{- $cachedMiseHash -}}" ]; then
    echo "mise: up to date ($mise_version), using cached hash."
    mise_hash="{{- $cachedMiseHash -}}"
else
    echo "mise: new version $mise_version, hash updated."
    mise_hash="{{- includeTemplate "mise-hash" . -}}"
fi

antigravity_version="{{- includeTemplate "antigravity-version" . -}}"
if [ "$antigravity_version" = "{{- $cachedAntigravityVersion -}}" ] \
    && [ -n "{{- $cachedAntigravityHash -}}" ]; then
    echo "Antigravity: up to date ($antigravity_version), using cached hash."
    antigravity_hash="{{- $cachedAntigravityHash -}}"
else
    echo "Antigravity: new version $antigravity_version, hash updated."
    antigravity_hash="{{- includeTemplate "antigravity-hash" . -}}"
fi

ollama_version="{{- includeTemplate "ollama-version" . -}}"
if [ "$ollama_version" = "{{- $cachedOllamaVersion -}}" ] \
    && [ -n "{{- $cachedOllamaHash -}}" ]; then
    echo "Ollama: up to date ($ollama_version), using cached hash."
    ollama_hash="{{- $cachedOllamaHash -}}"
else
    echo "Ollama: new version $ollama_version, hash updated."
    ollama_hash="{{- includeTemplate "ollama-hash" . -}}"
fi

obsidian_version="{{- includeTemplate "obsidian-version" . -}}"
if [ "$obsidian_version" = "{{- $cachedObsidianVersion -}}" ] \
    && [ -n "{{- $cachedObsidianHash -}}" ]; then
    echo "Obsidian: up to date ($obsidian_version), using cached hash."
    obsidian_hash="{{- $cachedObsidianHash -}}"
else
    echo "Obsidian: new version $obsidian_version, hash updated."
    obsidian_hash="{{- includeTemplate "obsidian-hash" . -}}"
fi

if [ ! -d ~/.config/chezmoi ]; then
    mkdir -p ~/.config/chezmoi
fi

cat <<EOF > ~/.config/chezmoi/chezmoi.toml
[edit]
command = "nvim"
[diff]
exclude = ["scripts"]
[data]
profile = "{{ $profile }}"
claudeVersion = "$claude_version"
claudeHash = "$claude_hash"
copilotVersion = "$copilot_version"
copilotHash = "$copilot_hash"
codexVersion = "$codex_version"
codexHash = "$codex_hash"
zedVersion = "$zed_version"
zedHash = "$zed_hash"
miseVersion = "$mise_version"
miseHash = "$mise_hash"
antigravityVersion = "$antigravity_version"
antigravityHash = "$antigravity_hash"
ollamaVersion = "$ollama_version"
ollamaHash = "$ollama_hash"
obsidianVersion = "$obsidian_version"
obsidianHash = "$obsidian_hash"
EOF
{{- end -}}

